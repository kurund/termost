Output demo/demo.gif

Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 16
Set Framerate 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "clear && exec bin/termost"
Enter
Sleep 3s
Show

Sleep 2s

Ctrl+K
Sleep 600ms
Type "back"
Sleep 800ms
Enter
Sleep 2.5s

Up
Sleep 600ms
Type "kk"
Sleep 800ms
Enter
Sleep 2s
Type "LGTM, approving now :thu"
Sleep 700ms
Tab
Sleep 500ms
Enter
Sleep 2s
Escape
Sleep 1.5s

Ctrl+F
Sleep 500ms
Type "index"
Sleep 300ms
Enter
Sleep 2.5s
Escape
Sleep 1s

Set TypingSpeed 0
Escape
Type "2"
Set TypingSpeed 60ms
Sleep 2s
Set TypingSpeed 0
Escape
Type "1"
Set TypingSpeed 60ms
Sleep 1.5s

Ctrl+K
Sleep 500ms
Type "lena"
Sleep 600ms
Enter
Sleep 1.5s
Type "Sure, sending them over now"
Sleep 300ms
Enter
Sleep 3s
